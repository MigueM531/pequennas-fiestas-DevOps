# Plantilla declarativa de Secret para Backend en Kubernetes.
# Copiar a k8s/backend-secret.yaml (ignorado por Git) o usar scripts/create-k8s-secrets.sh
apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: pequennas-fiestas
type: Opaque
stringData:
  DATABASE_URL: "postgresql://gigashow:CAMBIAR_PASSWORD_SEGURO@postgres-service:5432/gigashow"
  BETTER_AUTH_SECRET: "CAMBIAR_SECRET_DE_AUTENTICACION_DE_AL_MENOS_32_CHARS"
