# Plantilla declarativa de Secret para PostgreSQL en Kubernetes.
# Copiar a k8s/postgres-secret.yaml (ignorado por Git) o usar scripts/create-k8s-secrets.sh
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: pequennas-fiestas
type: Opaque
stringData:
  POSTGRES_DB: "gigashow"
  POSTGRES_USER: "gigashow"
  POSTGRES_PASSWORD: "CAMBIAR_PASSWORD_SEGURO_POSTGRES"
