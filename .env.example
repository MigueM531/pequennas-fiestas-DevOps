#------------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=gigashow
POSTGRES_USER=gigashow
# Reemplazar por una contraseña segura en producción:
POSTGRES_PASSWORD=gigashow_dev_password
DB_PORT=5433

# ------------------------------------------------------------------------------
# BACKEND API
# ------------------------------------------------------------------------------
PORT=3000
BACKEND_PORT=3000
BACKEND_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:8081
# Secret para Better Auth (mínimo 32 caracteres recomendados):
BETTER_AUTH_SECRET=cambiar_por_un_secreto_seguro_de_al_menos_32_caracteres_dev

# ------------------------------------------------------------------------------
# FRONTEND WEB
# ------------------------------------------------------------------------------
FRONTEND_PORT=8081
VITE_API_URL=http://localhost:3000
